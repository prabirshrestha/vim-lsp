Describe lsp#enable
    It should not autoload disabled features and should honor changed settings
        let l:script = tempname()
        let l:result = tempname()
        " The test runner's working directory is the plugin root.
        let l:root = getcwd()
        call writefile([
            \ 'set rtp^=' . fnameescape(l:root),
            \ 'try',
            \ '  source ' . fnameescape(l:root . '/test/testfiles/disabled_features.vim'),
            \ 'catch',
            \ '  call add(v:errors, v:exception . " at " . v:throwpoint)',
            \ 'endtry',
            \ 'call writefile(v:errors, ' . string(l:result) . ')',
            \ 'qa!',
            \ ], l:script)
        try
            let l:mode = has('nvim') ? ' --headless' : ' -es'
            call system(shellescape(v:progpath) . ' -u NONE -i NONE -n -N'
                \ . l:mode . ' -S ' . shellescape(l:script))
            Assert Equals(v:shell_error, 0)
            Assert Equals(readfile(l:result), [])
        finally
            call delete(l:script)
            call delete(l:result)
        endtry
    End
End
